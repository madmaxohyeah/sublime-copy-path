* text=auto eol=lf
*.sublime-package binary
*.png binary

# Package Control installs the GitHub archive of each version tag. Keep that
# archive identical to the built .sublime-package: everything that is not a
# package file is left out (checked by tools/check.py).
/.gitattributes export-ignore
/.gitignore export-ignore
/.github export-ignore
/.github/** export-ignore
/dist export-ignore
/dist/** export-ignore
/tests export-ignore
/tests/** export-ignore
/docs export-ignore
/docs/** export-ignore
/tools export-ignore
/tools/** export-ignore
