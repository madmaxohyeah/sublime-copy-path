FROM debian:trixie-slim@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        fonts-dejavu-core \
        libasound2t64 \
        libgtk-3-0 \
        openbox \
        python3 \
        python3-pil \
        xdotool \
        xvfb \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work
