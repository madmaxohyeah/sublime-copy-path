[
  {
    "id": "preferences",
    "children": [
      {
        "id": "package-settings",
        "children": [
          {
            "caption": "Copy Path",
            "children": [
              {
                "caption": "Settings",
                "command": "edit_settings",
                "args": {
                  "base_file": "${packages}/Copy Path/Copy Path.sublime-settings",
                  "default": "// Copy Path user settings: copy only the options you want to change\n// from the left pane. Everything else keeps its default.\n{\n\t$0\n}\n"
                }
              }
            ]
          }
        ]
      }
    ]
  }
]
